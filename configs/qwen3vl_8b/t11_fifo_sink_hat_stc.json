{
  "paths": {
    "annotations_file": "data/annotations/egostream_annotations.json",
    "clip_base_path": "data/videos",
    "output_dir": "outputs",
    "prompt_path": "prompts/ingestion_prompt.txt"
  },
  "model": {
    "model_id": "Qwen/Qwen3-VL-8B-Instruct",
    "min_pixels": 65536,
    "max_pixels": 1638400
  },
  "video_processing": {
    "fps_to_process": 1,
    "target_resolution": [
      896,
      512
    ],
    "stride": 16,
    "use_sliding_window": true,
    "dimention_sw": 16,
    "overlapping_sw": false
  },
  "generation": {
    "max_new_tokens": 4,
    "temperature": 0.01,
    "top_p": 0.9,
    "open_ended_max_new_tokens": 48,
    "open_ended_temperature": 0.5,
    "open_ended_top_p": 0.95,
    "open_ended_top_k": 0,
    "open_ended_repetition_penalty": 1.02,
    "open_ended_ban_eos_steps": 2
  },
  "cache": {
    "type": "FlexibleCache",
    "MAX_FRAMES_TO_PROCESS": 1000000,
    "mutable_token_size": 8192,
    "use_sliding_window": true,
    "frame_aware_ingestion": true,
    "use_sink_tokens": true,
    "sink_sys_prompt": true,
    "size_sink_tokens": 400,
    "use_hat_tokens": true,
    "hat_category": "frames",
    "hat_num_frames": 2,
    "size_hat_tokens": 448,
    "use_similarity": false,
    "similarity_merge": false,
    "similarity_keep_old": false,
    "intra_frame_pruning": false,
    "inter_frame_pruning": false,
    "pruning_pipeline": [],
    "enable_disk_offload": false,
    "offload_quantize": false,
    "retrieve": {
      "enabled": false
    },
    "stc_pruner": {
      "enabled": true,
      "implementation": "dual_anchor_paper",
      "pruning_ratio": 0.75,
      "alpha": 0.5,
      "history_window": 0,
      "min_tokens_per_frame": 1,
      "tokens_per_frame": null,
      "first_frame_temporal_anchor": "spatial",
      "score_dtype": "float32",
      "log_every_batches": 100
    }
  },
  "verbose": false
}
