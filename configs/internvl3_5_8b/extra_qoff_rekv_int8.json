{
  "paths": {
    "annotations_file": "data/annotations/egostream_annotations.json",
    "clip_base_path": "data/videos",
    "output_dir": "outputs",
    "prompt_path": "prompts/ingestion_prompt.txt"
  },
  "model": {
    "model_id": "OpenGVLab/InternVL3_5-8B-HF",
    "min_pixels": 65536,
    "max_pixels": 1638400
  },
  "video_processing": {
    "fps_to_process": 1,
    "target_resolution": [
      896,
      512
    ],
    "stride": 16,
    "use_sliding_window": true,
    "dimention_sw": 16,
    "overlapping_sw": false
  },
  "generation": {
    "max_new_tokens": 4,
    "temperature": 0.01,
    "top_p": 0.9,
    "open_ended_max_new_tokens": 48,
    "open_ended_temperature": 0.5,
    "open_ended_top_p": 0.95,
    "open_ended_top_k": 0,
    "open_ended_repetition_penalty": 1.02,
    "open_ended_ban_eos_steps": 2
  },
  "cache": {
    "type": "FlexibleCache",
    "MAX_FRAMES_TO_PROCESS": 1000000,
    "mutable_token_size": 8192,
    "use_sliding_window": true,
    "use_sink_tokens": true,
    "sink_sys_prompt": true,
    "size_sink_tokens": 400,
    "use_hat_tokens": true,
    "hat_category": "frames",
    "hat_num_frames": 2,
    "size_hat_tokens": 400,
    "use_similarity": false,
    "similarity_merge": false,
    "similarity_keep_old": false,
    "intra_frame_pruning": false,
    "inter_frame_pruning": false,
    "enable_disk_offload": true,
    "offload_dir": "outputs/extra_qoff_rekv_int8/kv_offload",
    "offload_min_tokens": 1,
    "offload_empty_cache": true,
    "offload_quantize": true,
    "offload_quant_bits": 8,
    "offload_quant_scheme": "per_tensor",
    "pruning_pipeline": [
      {
        "name": "rekv_int8_offload_left_excess",
        "domain": "storage",
        "scorer": "none",
        "reducer": "offload",
        "enabled": true,
        "params": {
          "scope": "left_excess",
          "quantize": true,
          "bits": 8,
          "scheme": "per_tensor"
        }
      }
    ],
    "retrieve": {
      "enabled": true,
      "method": "rekv",
      "top_k_tokens": 8192,
      "block_size_frames": 1,
      "include_live_mutable": true,
      "max_offloaded_chunks": null
    },
    "debug_cache_layout": false,
    "debug_tracking": false
  },
  "verbose": false
}
