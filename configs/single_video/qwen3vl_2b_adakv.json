{
  "paths": {
    "video_path": "../../data/sample/sample_video.mp4",
    "prompt_path": "../../prompts/ingestion_prompt.txt"
  },
  "model": {
    "model_id": "Qwen/Qwen3-VL-2B-Instruct",
    "min_pixels": 65536,
    "max_pixels": 1638400
  },
  "video_processing": {
    "fps_to_process": 1,
    "target_resolution": [
      896,
      512
    ],
    "stride": 4,
    "use_sliding_window": true,
    "dimention_sw": 4,
    "overlapping_sw": false
  },
  "generation": {
    "max_new_tokens": 1,
    "temperature": 0.01,
    "top_p": 0.9,
    "open_ended_max_new_tokens": 8,
    "open_ended_temperature": 0.5,
    "open_ended_top_p": 0.95,
    "open_ended_top_k": 0,
    "open_ended_repetition_penalty": 1.2,
    "open_ended_ban_eos_steps": 2
  },
  "cache": {
    "type": "FlexibleCache",
    "MAX_FRAMES_TO_PROCESS": 4,
    "mutable_token_size": 256,
    "use_sliding_window": true,
    "use_sink_tokens": true,
    "sink_sys_prompt": true,
    "size_sink_tokens": 128,
    "use_hat_tokens": true,
    "hat_category": "frames",
    "hat_num_frames": 1,
    "size_hat_tokens": 256,
    "use_similarity": false,
    "similarity_merge": false,
    "similarity_keep_old": false,
    "intra_frame_pruning": false,
    "inter_frame_pruning": false,
    "enable_disk_offload": false,
    "offload_quantize": false,
    "retrieve": {
      "enabled": false
    },
    "adakv": {
      "enabled": true,
      "total_budget": 256,
      "importance_source": "attention",
      "observation_window": 16,
      "kernel_size": 7,
      "pooling": "maxpool",
      "floor_alpha": 0.2,
      "min_budget_per_kv_head": 1,
      "gqa_reduction": "mean",
      "attention_backend": "sdpa",
      "compatibility_mode": "exact",
      "log_every_reductions": 1
    },
    "debug_cache_layout": true,
    "debug_tracking": true
  },
  "single_video_test": {
    "until_second": 4,
    "question": "Describe this video briefly."
  },
  "verbose": true
}
